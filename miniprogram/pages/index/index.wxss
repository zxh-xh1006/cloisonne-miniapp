/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d1b2a 0%, #1b263b 100%);
}

/* Hero 区 */
.hero {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(26, 75, 140, 0.4) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.2) 0%, transparent 50%),
    linear-gradient(135deg, #0d1b2a 0%, #1b263b 100%);
}

.hero-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(45deg, transparent, transparent 40rpx, rgba(212, 175, 55, 0.03) 40rpx, rgba(212, 175, 55, 0.03) 80rpx);
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 80rpx 48rpx 0;
}

.hero-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #d4af37;
  letter-spacing: 8rpx;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.5);
  font-family: "STKaiti", "KaiTi", serif;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #f0e6d2;
  letter-spacing: 4rpx;
}

.hero-desc {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #a8b2c1;
  line-height: 1.6;
}

/* 上传入口 */
.upload-section {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.upload-card {
  flex: 1;
  background: linear-gradient(145deg, #1b2838 0%, #243447 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  transition: transform 0.2s;
}

.upload-card:active {
  transform: scale(0.96);
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  color: #d4af37;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.upload-desc {
  color: #6c7a89;
  font-size: 24rpx;
}

/* 区块 */
.section {
  padding: 40rpx 32rpx 0;
}

.section-title {
  margin-bottom: 24rpx;
}

/* 科普卡片 */
.intro-card {
  line-height: 1.8;
}

.intro-text {
  color: #a8b2c1;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.highlight {
  color: #d4af37;
  font-weight: bold;
}

.intro-steps {
  margin: 24rpx 0;
  padding: 24rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 12rpx;
}

.step-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-item:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d4af37, #f4d03f);
  color: #1a1a1a;
  font-weight: bold;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  color: #f0e6d2;
  font-size: 28rpx;
}

/* 案例展示 */
.cases-scroll {
  white-space: nowrap;
  width: 100%;
}

.cases-list {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 16rpx;
}

.case-item {
  display: inline-block;
  width: 200rpx;
  vertical-align: top;
}

.case-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.case-pattern {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.pattern-circle {
  position: absolute;
  inset: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
}

.pattern-circle-2 {
  inset: 30rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
}

.case-title {
  margin-top: 12rpx;
  text-align: center;
  color: #f0e6d2;
  font-size: 26rpx;
}

/* 图片类型网格 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  width: calc(20% - 16rpx);
  text-align: center;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.type-name {
  color: #a8b2c1;
  font-size: 24rpx;
}

.footer-space {
  height: 60rpx;
}
