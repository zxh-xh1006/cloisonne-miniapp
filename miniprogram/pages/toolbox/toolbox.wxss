/* pages/toolbox/toolbox.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d1b2a 0%, #1b263b 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  color: #6c7a89;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

/* 视图切换 */
.view-switcher {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 40rpx;
  color: #6c7a89;
  font-size: 28rpx;
  transition: all 0.3s;
}

.view-tab.active {
  background: linear-gradient(135deg, #d4af37, #f4d03f);
  color: #1a1a1a;
  font-weight: bold;
}

.preview-wrap {
  background: #0a0a0a;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
}

.preview-img {
  width: 100%;
  height: 500rpx;
  border-radius: 8rpx;
}

/* 工具区 */
.tool-section {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.tool-title {
  color: #d4af37;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.slider-group {
  margin-bottom: 28rpx;
}

.slider-group:last-child {
  margin-bottom: 0;
}

.slider-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.slider-label text:first-child {
  color: #f0e6d2;
  font-size: 28rpx;
}

.slider-value {
  color: #d4af37;
  font-size: 26rpx;
  font-weight: bold;
}

/* 配色方案 */
.scheme-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.scheme-item {
  width: calc(50% - 8rpx);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.scheme-item.active {
  border-color: #d4af37;
  background: rgba(212, 175, 55, 0.1);
}

.scheme-colors {
  display: flex;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.scheme-color {
  flex: 1;
  height: 36rpx;
  border-radius: 6rpx;
}

.scheme-name {
  color: #f0e6d2;
  font-size: 24rpx;
  text-align: center;
}

/* 自定义配色 */
.custom-colors {
  margin-top: 20rpx;
}

.custom-title {
  color: #a8b2c1;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.custom-color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.custom-color {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.custom-tip {
  margin-top: 16rpx;
  color: #6c7a89;
  font-size: 22rpx;
}

/* 操作按钮 */
.action-group {
  margin-bottom: 20rpx;
}

.action-group-row {
  display: flex;
  gap: 20rpx;
}

.action-group-row button {
  flex: 1;
  margin: 0;
}
