/* pages/favorite-detail/favorite-detail.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d1b2a 0%, #1b263b 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.view-switcher {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 40rpx;
  color: #6c7a89;
  font-size: 28rpx;
  transition: all 0.3s;
}

.view-tab.active {
  background: linear-gradient(135deg, #d4af37, #f4d03f);
  color: #1a1a1a;
  font-weight: bold;
}

.preview-wrap {
  background: #0a0a0a;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 32rpx;
}

.preview-img {
  width: 100%;
  height: 600rpx;
  border-radius: 8rpx;
}

.action-group-row {
  display: flex;
  gap: 20rpx;
}

.action-group-row button {
  flex: 1;
  margin: 0;
}
